<Window x:Class="DaDPlaylistManager.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Sign in to share playlists" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8"
                   Text="Use the same name and password as on the group website." />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Website" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Margin="6,0,0,0" Content="Connect" Click="Connect_Click" />
            <TextBox x:Name="ServerBox" />
        </DockPanel>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Who are you?" />
        <ComboBox x:Name="PlayerBox" DisplayMemberPath="Name" />

        <TextBlock Style="{StaticResource FieldLabel}" Text="Password" />
        <PasswordBox x:Name="PasswordBox" KeyDown="PasswordBox_KeyDown" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource ToolButton}" Content="Cancel" IsCancel="True" />
            <Button x:Name="SignInButton" Style="{StaticResource AccentToolButton}" Margin="0" Content="Sign in" Click="SignIn_Click" />
        </StackPanel>
    </StackPanel>
</Window>
